{
  "$schema": "https://app.kilo.ai/config.json",
  "skills": {
    "paths": [
      "/home/shaurya/.agents/skills"
    ]
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "type": "local",
    },
    "gitnexus": {
      "type": "local",
      "command": [
        "gitnexus",
        "mcp"
      ]
    }
  },
  "permission": {
    "bash": "allow"
  }
}
